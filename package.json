{
  "name": "feedbackops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "gen:routes": "node scripts/generate-routes.mjs",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:design": "oxlint --max-warnings 0 apps/frontend/src packages/ui/src",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "gate:db-migration-drift": "node scripts/gates/db-migration-drift-gate.mjs",
    "gate:fe-typecheck": "node scripts/gates/fe-typecheck-gate.mjs",
    "gate:fe-lint": "node scripts/gates/fe-biome-gate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@shadcn/lint": "0.2.0",
    "oxlint": "1.86.0",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "@formkit/auto-animate@0.10.0": "patches/@formkit__auto-animate@0.10.0.patch"
    }
  }
}
