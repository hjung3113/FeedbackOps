import { mkdir } from 'node:fs/promises';
import { resolve } from 'node:path';

// visual-test supplies the pinned FIXED_CLOCK fixture and reduced-motion page setup.
import { expect, test } from './support/visual-test';
import { installMockApi } from './support/mock-api';

const captureName = __CAPTURE_NAME__;
const route = __ROUTE__;
const stateLabels: string[] = __STATES__;
const shotsDirectory = __SHOTS_DIR__;

function safeLabel(label: string): string {
  return label.replace(/[^A-Za-z0-9_-]+/g, '-').replace(/^-|-$/g, '') || 'state';
}

test(`temporary visual capture: ${captureName}`, async ({ page }) => {
  await page.setViewportSize({ width: 1440, height: 960 });
  await mkdir(shotsDirectory, { recursive: true });
  await installMockApi(page);

  const savedPaths: string[] = [];
  for (const [index, stateLabel] of stateLabels.entries()) {
    await page.goto(route);
    await page.waitForLoadState('networkidle');
    await expect(page.locator('body')).toBeVisible();
    await page.evaluate(() => document.fonts.ready);

    const number = String(index + 1).padStart(2, '0');
    const screenshotPath = resolve(shotsDirectory, `${number}-${safeLabel(stateLabel)}.png`);
    await page.screenshot({
      path: screenshotPath,
      fullPage: false,
      animations: 'disabled',
      caret: 'hide',
      scale: 'css',
    });
    savedPaths.push(screenshotPath);
  }

  console.log(`CAPTURED ${captureName}: ${savedPaths.join(', ')}`);
});
