# FeedbackOps environment template. Copy to `.env` and fill in.
# Real `.env*` files are gitignored.

# --- Server runtime ---
# 'development' | 'test' | 'production'. Defaults to 'development'.
NODE_ENV=development
# Backend HTTP port. Vite dev proxy expects 3011 (see vite.config.ts).
PORT=3011
# Bind host for Fastify. 0.0.0.0 listens on all interfaces (dev/docker).
HOST=0.0.0.0
# ADR-0006: single seeded workspace. UUID of the dev workspace (matches seed CLI output).
WORKSPACE_ID=00000000-0000-0000-0000-000000000001
# Display name for the seeded workspace.
WORKSPACE_NAME=FeedbackOps
# 'mock' = local dev session shim; 'oidc' = real provider (production-only).
AUTH_PROVIDER=mock
# Slice 1 seed scope. Only 'core' is supported today.
SEED_MODE=core

# --- OIDC (required when AUTH_PROVIDER=oidc, ignored otherwise) ---
# Real IdP configuration (ADR-0006, amended 2026-09-22 / issue #390).
# All four OIDC_* variables below are REQUIRED when AUTH_PROVIDER=oidc;
# config load fails before boot when any is missing or inconsistent.
# NEVER commit a real secret here.
# Issuer identifier of the IdP. Absolute https URL, no query/fragment/
# credentials. Plain http is allowed only for http://localhost[:port] or
# http://127.0.0.1[:port] and only outside production.
OIDC_ISSUER_URL=
# OAuth client id at the IdP (non-empty).
OIDC_CLIENT_ID=
# OAuth client secret at the IdP (non-empty). Never commit a real value.
OIDC_CLIENT_SECRET=
# Where the IdP sends the browser after login. Absolute URL whose path is
# EXACTLY /auth/callback, no fragment; https in production (http localhost /
# 127.0.0.1 allowed outside production).
OIDC_REDIRECT_URI=http://localhost:3011/auth/callback
# Space-separated scopes. Must include 'openid'. Default below.
OIDC_SCOPES=openid email profile

# CSP `img-src`/`connect-src` origin for public attachment URLs. Accepted:
# the quoted literal `'self'` (default; keeps everything same-origin) or a
# bare origin `https://host[:port]` — no path, query, credentials, or
# wildcards. Outside production, `http://localhost[:port]` and
# `http://127.0.0.1[:port]` are also accepted. Anything else fails config
# load (#402).
PUBLIC_ATTACHMENT_ORIGIN="'self'"
# Number of trusted proxy hops in front of Fastify (X-Forwarded-For chain
# depth). 0 outside production = trust nothing. Set to 1 in prod when a
# single ingress terminates TLS. See Review HTTP-H-2 / ADR-0015.
TRUSTED_PROXY_HOPS=0

# --- Embeddings (ADR-0034 D2) ---
# 'disabled' (default), 'fake' for deterministic offline tests, or 'voyage'.
EMBEDDING_PROVIDER=disabled
# Required when EMBEDDING_PROVIDER=voyage. Never commit a real key.
EMBEDDING_API_KEY=
# Increment when changing model/version so stored vectors are re-embedded.
EMBEDDING_VERSION=1

# --- Postgres (matches docker-compose.dev.yml :5434) ---
DATABASE_URL=postgres://fops_app:fops_app@localhost:5434/feedbackops
DATABASE_URL_MIGRATE=postgres://fops_migrate:fops_migrate@localhost:5434/feedbackops

# --- Attachment storage (S3-compatible, MinIO in dev/prod per ADR-0011 amendment) ---
# Swap endpoint/region/credentials to point at AWS S3 or Cloudflare R2 in prod.
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=fops-attachments
STORAGE_S3_ACCESS_KEY_ID=fops-minio
STORAGE_S3_SECRET_ACCESS_KEY=fops-minio-secret-change-me
STORAGE_S3_FORCE_PATH_STYLE=true
